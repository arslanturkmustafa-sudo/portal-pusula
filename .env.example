# Yalnız değişken adları ve güvenli açıklamalar bulunur; gerçek değer yazmayın.

# Boşsa "info" varsayılır.
LOG_LEVEL=

# Boşsa "localhost" varsayılır.
DB_HOST=

# Boşsa 3306 varsayılır.
DB_PORT=

# Hostinger MySQL veritabanı adı; zorunlu.
DB_NAME=

# Hostinger MySQL kullanıcı adı; zorunlu.
DB_USER=

# Hostinger environment alanında tutulacak veritabanı parolası; zorunlu ve gizli.
DB_PASSWORD=

# Tam 16 karakter, yalnız ASCII A-Z/a-z/0-9 ve rastgele üretilmiş Bearer token; zorunlu ve gizli.
READINESS_BEARER_TOKEN=

# Yerel cron aday route'u varsayılan olarak kapalıdır; yalnız exact "true" etkinleştirir.
# Bu değişken canlı Hostinger'a bu dilimde eklenmez.
CRON_ENDPOINT_ENABLED=

# Etkin yerel aday için tam 43 karakter base64url (32 rastgele byte eşdeğeri),
# READINESS_BEARER_TOKEN'dan farklı ve gizli olmalıdır. Bu dilimde canlı değer yoktur.
CRON_BEARER_TOKEN=

# Cron adayi yalniz etkinse zorunlu, exact tam sayi 60..86400 saniye.
# Bu dilimde canli Hostinger'a eklenmez ve burada gercek deger tutulmaz.
CRON_MIN_INTERVAL_SECONDS=
