# Yalnız değişken adları ve güvenli açıklamalar bulunur; gerçek değer yazmayın.

# Boşsa "info" varsayılır.
LOG_LEVEL=

# Boşsa "localhost" varsayılır.
DB_HOST=

# Boşsa 3306 varsayılır.
DB_PORT=

# Hostinger MySQL veritabanı adı; zorunlu.
DB_NAME=

# Hostinger MySQL kullanıcı adı; zorunlu.
DB_USER=

# Hostinger environment alanında tutulacak veritabanı parolası; zorunlu ve gizli.
DB_PASSWORD=

# Tam 16 karakter, yalnız ASCII A-Z/a-z/0-9 ve rastgele üretilmiş Bearer token; zorunlu ve gizli.
READINESS_BEARER_TOKEN=

# Günlük e-posta tetikleyicisi için iç cron route'u; yalnız exact "true" etkinleştirir.
CRON_ENDPOINT_ENABLED=

# Tam 43 karakter base64url (32 rastgele byte eşdeğeri),
# READINESS_BEARER_TOKEN'dan farklı ve gizli olmalıdır.
CRON_BEARER_TOKEN=

# Cron yalnız etkinse zorunlu, exact tam sayı 60..86400 saniye.
CRON_MIN_INTERVAL_SECONDS=

# E-posta bildirimleri varsayılan kapalıdır; yalnız exact "true" etkinleştirir.
EMAIL_NOTIFICATIONS_ENABLED=

# Resend API anahtarı; yalnız Hostinger environment alanında tutulur ve gizlidir.
RESEND_API_KEY=

# Resend üzerinde doğrulanmış gönderen adresi; gerçek değer burada tutulmaz.
EMAIL_FROM_ADDRESS=

# İsteğe bağlı görünen gönderen adı; boşsa "Portal Pusula" kullanılır.
EMAIL_FROM_NAME=

# Yönetici girişi. Gerçek değerler yalnız yerel .env.local veya Hostinger panelinde tutulur.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Canlıda ve varsayılan kullanımda "database"; "environment" yalnız açık uyumluluk/E2E modu.
PORTAL_PUSULA_AUTH_STORAGE_MODE=database

# Localhost-only development convenience. Keep false in shared/LAN environments.
PORTAL_PUSULA_ALLOW_DEV_AUTH_BYPASS=false

# ByPusula otomatik aktarım: varsayılan kapalı. Anahtar iki sunucuda güvenli tutulur.
# Her alan gerçek sunucu yapılandırmasında verilir; secret repoya/ZIP'e yazılmaz.
BYPUSULA_SYNC_ENABLED=false
BYPUSULA_SYNC_KEY_ID=
BYPUSULA_SYNC_SECRET=
BYPUSULA_SYNC_INSTANCE_ID=
BYPUSULA_SYNC_ACCOUNT_ID=
BYPUSULA_SYNC_ACTOR_ID=
